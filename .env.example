# PostgreSQL
DATABASE_URL=postgresql+psycopg2://ftth:ftth@127.0.0.1:5432/ftth

# Redis / Celery
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
LRU_CACHE_MAX_SIZE=10000
LRU_CACHE_TTL=2592000

# RabbitMQ (A2A agent bus)
RABBITMQ_URL=amqp://ftth:ftth@127.0.0.1:5672/ftth

# JWT (generate a long random string for production)
JWT_SECRET_KEY=change-me-in-production
JWT_EXPIRE_HOURS=24

# Google APIs (Street View, Geocoding, Maps Embed)
GOOGLE_MAPS_API_KEY=
GOOGLE_GEOCODING_API_KEY=
GOOGLE_API_KEY=

# Address validation
SMARTY_AUTH_ID=
SMARTY_AUTH_TOKEN=
MELISSA_LICENSE_KEY=

# Vision / Agent 5
AZURE_VISION_ENDPOINT=
AZURE_VISION_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# Local OCR / LLM
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_VISION_MODEL=qwen2.5vl:latest
FTTH_ENABLE_PADDLE_OCR=1

# Pipeline thresholds (score >= threshold may stop at that agent)
AGENT0_CONFIDENCE_THRESHOLD=90
AGENT1_CONFIDENCE_THRESHOLD=90
AGENT2_CONFIDENCE_THRESHOLD=90
AGENT3_CONFIDENCE_THRESHOLD=90
AGENT5_CONFIDENCE_THRESHOLD=90
AGENT6_CONFIDENCE_THRESHOLD=90

# Database pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Logging (set FTTH_LOG_JSON=1 for JSON logs in production)
FTTH_LOG_JSON=0
FTTH_SSL_VERIFY=0
FTTH_DEV_RELOAD=1
FTTH_ENV=development
FTTH_CORS_ORIGINS=http://localhost,http://127.0.0.1
FTTH_MAX_UPLOAD_BYTES=104857600
FTTH_MAX_ZIP_ENTRIES=500
FTTH_LOGIN_RATE_LIMIT=10
FTTH_LOGIN_RATE_WINDOW=60
FTTH_REQUIRE_REDIS=0
FTTH_REQUIRE_RABBITMQ=0
FTTH_HSTS=0
RES_COM_ADDRESSING_ENABLED=true
POSTGIS_ENABLED=false

