# PostgreSQL â€” local Windows install
# App user:   ftth  / ftth      (use for application connections)
# Admin user: postgres / postgres (superuser, for admin/migrations only)
DATABASE_URL=postgresql+psycopg2://ftth:ftth@127.0.0.1:5432/ftth

# Logging
LOG_LEVEL=INFO

# Ingestion defaults
DEFAULT_CUSTOMER_ID=demo_customer
DISPATCH_BATCH_SIZE=100

# â”€â”€ Redis (cache DB=0, Celery broker DB=1, Celery results DB=2) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
REDIS_URL=redis://127.0.0.1:6379/0

# â”€â”€ LRU cache tuning â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
LRU_CACHE_MAX_SIZE=10000
LRU_CACHE_TTL=2592000

# â”€â”€ JWT auth â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
JWT_SECRET_KEY=REPLACE_WITH_YOUR_JWT_SECRET_KEY
JWT_EXPIRE_HOURS=24

# â”€â”€ Celery (Redis broker keeps tasks; RabbitMQ handles A2A agent messaging) â”€â”€
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# â”€â”€ RabbitMQ â€” A2A agent bus (Peer-Peer + Broadcast) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
RABBITMQ_URL=amqp://ftth:ftth@127.0.0.1:5672/ftth

# â”€â”€ Reverse geocoder / coord validation (corporate network SSL) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
GOOGLE_MAPS_API_KEY=REPLACE_WITH_YOUR_GOOGLE_MAPS_API_KEY
GOOGLE_GEOCODING_API_KEY=REPLACE_WITH_YOUR_GOOGLE_GEOCODING_API_KEY
FTTH_SSL_VERIFY=0
FTTH_SKIP_NOMINATIM=1

# Pipeline confidence routing thresholds.
# Rows with score >= threshold stop at that agent; lower scores continue onward.
AGENT0_CONFIDENCE_THRESHOLD=90
AGENT1_CONFIDENCE_THRESHOLD=90
AGENT2_CONFIDENCE_THRESHOLD=90
AGENT3_CONFIDENCE_THRESHOLD=90
AGENT5_CONFIDENCE_THRESHOLD=90
AGENT6_CONFIDENCE_THRESHOLD=90


# Azure AI Vision (Computer Vision)
AZURE_VISION_ENDPOINT=https://dines-mmxdlts2-eastus2.cognitiveservices.azure.com/
AZURE_VISION_KEY=REPLACE_WITH_YOUR_AZURE_VISION_KEY



# Agent 5 vision LLM â€” Azure OpenAI (house-number read + obstruction reasoning)
# Same Cognitive Services resource as AZURE_VISION above; replace the key if the
# Azure OpenAI key differs from the Computer Vision key.
AZURE_OPENAI_API_KEY=REPLACE_WITH_YOUR_AZURE_OPENAI_API_KEY
AZURE_OPENAI_ENDPOINT=https://dines-mmxdlts2-eastus2.cognitiveservices.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-5.3-chat
AZURE_OPENAI_API_VERSION=2024-02-01
# FTTH_ENABLE_GPT_VISION=1   # set 0 to hard-disable the vision LLM (OCR-only)
 
# Agent 5 â€” local PaddleOCR (requires Python 3.11/3.12 venv; see start_localhost_full_pipeline.bat)
FTTH_ENABLE_PADDLE_OCR=1
FTTH_ENABLE_PADDLEOCR_SCAN=1

# Agent 5 logging (writes to logs/agent5_streetview.log)
# FTTH_AGENT5_LOG=1            # set 0 to disable Agent 5 file logging
# FTTH_AGENT5_LOG_PAYLOADS=1   # set 0 to omit full API request/response payloads
# FTTH_AGENT5_LOG_MAXLEN=6000  # max chars per logged payload before truncation
# FTTH_AGENT5_LOG_FILE=...     # override the log file path

# Updated from Meridian app settings
SMARTY_AUTH_ID=5fae6f88-1ae7-168a-6073-a64340a0d991
SMARTY_AUTH_TOKEN=REPLACE_WITH_YOUR_SMARTY_AUTH_TOKEN

# Updated from Meridian app settings
GOOGLE_API_KEY=REPLACE_WITH_YOUR_GOOGLE_API_KEY
